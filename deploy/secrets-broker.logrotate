/var/log/secrets-broker/audit.jsonl {
    daily
    rotate 30
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    nodateext
    nocopytruncate
    create 0600 secrets-broker secrets-broker
    su secrets-broker secrets-broker
}

/var/log/secrets-broker-admin/audit.jsonl {
    daily
    rotate 30
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    nodateext
    nocopytruncate
    create 0600 root root
    su root root
}
