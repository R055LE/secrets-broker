Defaults!/usr/local/libexec/secrets-broker-worker secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Defaults:secrets-broker secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Agent-facing CLI: fixed worker path, no worker arguments, dedicated worker UID.
%secrets-broker-clients ALL=(secrets-broker) NOPASSWD: /usr/local/libexec/secrets-broker-worker ""

# The worker passes only bws-injected project secrets to a separate runner UID.
# The runner cannot read the bootstrap token, policy, or audit log.
secrets-broker ALL=(secrets-broker-runner) NOPASSWD: SETENV: ALL
